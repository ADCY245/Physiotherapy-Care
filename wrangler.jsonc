{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "physiotherapy-care",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "."
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
