{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "physiotherapy-care",
  "compatibility_date": "2026-11-06",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ENQUIRY_FROM_EMAIL": "enquiry@physiotherapyandcare.in",
    "ENQUIRY_CC_EMAIL": "drronak@physiotherapyandcare.in",
    "ENQUIRY_REPLY_TO": "ronak@physiotherapyandcare.in"
  },
  "ratelimits": [
    {
      "name": "ENQUIRY_RATE_LIMITER",
      "namespace_id": "2026110601",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
